# Disposable local values only; never use this password outside Compose.
# Keep these values URL-safe because Compose constructs the SQLAlchemy URL.
POSTGRES_USER=nik
POSTGRES_PASSWORD=local_development_only
POSTGRES_DB=nik

# Submissions stay off by default and also need a configured GitHub publisher to open.
SUBMISSIONS_ENABLED=false

# Official visible, always-pass Turnstile test keys (not production credentials).
# See docs/submissions.md for submission settings; browsing does not need Turnstile or GitHub.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
