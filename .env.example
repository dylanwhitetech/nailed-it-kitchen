# Local configuration for the planned Compose stack; see docs/submissions.md for every setting.
# Submissions stay off by default and also need a configured GitHub publisher to open.
SUBMISSIONS_ENABLED=false

# Cloudflare's public always-pass Turnstile test keys (docs/new-dev-setup.md).
# Never put production credentials in this file.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
