# Disposable local values only; never use this password outside Compose.
# Keep these values URL-safe because Compose constructs the SQLAlchemy URL.
POSTGRES_USER=nik
POSTGRES_PASSWORD=local_development_only
POSTGRES_DB=nik

# Keep submissions disabled until their protections are implemented and verified.
SUBMISSIONS_ENABLED=false

# Official visible, always-pass Turnstile test keys (not production credentials).
# Reserved for the submission workstream; browsing does not need Turnstile or GitHub.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
